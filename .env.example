# StudySync backend settings. Copy to .env for local development; on a host
# like Render, set the same keys in its Environment tab instead (no quotes).
# The server checks these at startup and refuses to start, listing EVERY
# problem at once, if something required is missing or malformed.
# All parsing and defaults live in src/config/env.js.

# --- basics ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# This API's public URL (required in production), e.g. https://api.example.com
BASE_URL=http://localhost:3000
# The website's URL (required in production). Always allowed by CORS, and
# where emails/redirects link to.
FRONTEND_URL=http://localhost:5173

# --- database / cache (required) ------------------------------------------
# Must start with mongodb:// or mongodb+srv://
MONGO_URI=mongodb://localhost:27017/studysync

# Either one URL (redis:// or rediss:// for TLS - Render/Upstash style)...
# REDIS_URL=rediss://default:password@host:6379
# ...or host/port/password. REDIS_URL wins when both are set.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Force TLS for host/port connections (automatic with rediss://).
# REDIS_TLS=false

# --- secrets (required; long random strings, e.g. `openssl rand -hex 32`) --
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# Lifetimes in seconds.
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=604800
# How long a just-rotated refresh token is still accepted (two tabs
# refreshing at once) before reuse counts as theft.
# REFRESH_REUSE_GRACE_SECONDS=10

# --- network access ---------------------------------------------------------
# Extra websites allowed to call this API and open live connections, besides
# FRONTEND_URL. Comma-separated; exact origins or wildcard subdomains.
# CORS_ORIGINS=https://admin.example.com,https://*.preview.example.com
# Allow any http://localhost:<port> / 127.0.0.1 page (Vite dev servers).
# Default: on outside production, off in production.
# CORS_ALLOW_LOCALHOST=true
# Behind a load balancer / reverse proxy (Render, Heroku, nginx...), set how
# many proxy hops to trust - otherwise every visitor looks like the proxy's IP
# and they all share ONE rate limit. Render: 1. Also accepts true/false or a
# comma list of proxy IPs/subnets. Leave unset when clients connect directly
# (setting it then would let anyone fake their IP with X-Forwarded-For).
# TRUST_PROXY=1
# Pages allowed to show uploaded files in an <iframe> (attachment previews).
# Default: FRONTEND_URL + CORS_ORIGINS (+ localhost when allowed).
# UPLOADS_FRAME_ANCESTORS=https://app.example.com

# --- login cookies ----------------------------------------------------------
# Frontend and API on different sites (two *.onrender.com hosts): none + secure
# (the production default). Same site (app./api.example.com): lax or strict.
# Default: none in production, strict otherwise.
# COOKIE_SAMESITE=none
# Default: true in production. Must be true with SameSite=none.
# COOKIE_SECURE=true
# Share cookies across subdomains, e.g. .example.com. Default: API host only.
# COOKIE_DOMAIN=

# --- rate limits (per client IP; requests per window) ----------------------
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_AUTH_WINDOW_MINUTES=15
# RATE_LIMIT_UPLOAD_MAX=30
# RATE_LIMIT_UPLOAD_WINDOW_MINUTES=15
# RATE_LIMIT_CONTACT_MAX=10
# RATE_LIMIT_CONTACT_WINDOW_MINUTES=15

# --- upload size limits (MB; the website reads these from /api/config) -----
# UPLOAD_MAX_ATTACHMENT_MB=20
# UPLOAD_MAX_MATERIAL_MB=25

# --- email (Postmark SMTP) --------------------------------------------------
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
POSTMARK_API_KEY=change-me
EMAIL_FROM=no-reply@example.com

# --- Google sign-in (optional) ----------------------------------------------
# Set all three to turn it on; leave all three unset to turn it off (the
# website then hides its Google buttons). Setting only some is an error.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- misc -------------------------------------------------------------------
# trace | debug | info | warn | error
# LOG_LEVEL=info
# Only read by `node scripts/make-admin.js --create` (not by the server).
# ADMIN_PASSWORD=
