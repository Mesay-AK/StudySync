NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

MONGO_URI=mongodb://localhost:27017/studysync

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_RESET_SECRET=change-me
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=604800
JWT_RESET_TOKEN_EXPIRY=3600

# Postmark SMTP (https://postmarkapp.com/support/article/1002-what-are-the-smtp-settings-for-postmark)
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
POSTMARK_API_KEY=change-me
EMAIL_FROM=no-reply@example.com

GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

SESSION_SECRET=change-me
